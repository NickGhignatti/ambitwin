{
  "description": "The body POSTed to /telemetry/ingest. Built by aq-simulator and sensor-simulator, and by telemetry itself when it counts a Wi-Fi tick; parsed by telemetry, which walks it as raw JSON rather than a type. One tick is one batch, all-or-nothing, at most 500 readings.",
  "rules": {
    "buildingId": "Carried once by the batch, never repeated on a reading. Telemetry stamps it onto every reading before validating; a reading naming a different building is rejected.",
    "type": "The metric id, in snake_case. Selects the plugin that checks the reading.",
    "value": "One number per reading. A device measuring several metrics sends one reading for each."
  },
  "cases": [
    {
      "name": "temperature -- one room, one tick",
      "producer": "sensor-simulator",
      "body": {
        "buildingId": "bldg-3f2b4c5d",
        "readings": [
          {
            "type": "temperature",
            "roomId": "room-lab-2",
            "timestamp": 1757251200000,
            "value": 21.5
          }
        ]
      }
    },
    {
      "name": "people_count -- an integer value",
      "producer": "sensor-simulator",
      "body": {
        "buildingId": "bldg-3f2b4c5d",
        "readings": [
          {
            "type": "people_count",
            "roomId": "room-lab-2",
            "timestamp": 1757251200000,
            "value": 14
          }
        ]
      }
    },
    {
      "name": "an air station -- one reading per metric it measures",
      "producer": "aq-simulator",
      "body": {
        "buildingId": "bldg-3f2b4c5d",
        "readings": [
          {
            "type": "co2",
            "roomId": "room-lab-2",
            "timestamp": 1757251200000,
            "value": 612.0
          },
          {
            "type": "indoor_aqi",
            "roomId": "room-lab-2",
            "timestamp": 1757251200000,
            "value": 41.2
          },
          {
            "type": "humidity",
            "roomId": "room-lab-2",
            "timestamp": 1757251200000,
            "value": 44.0
          }
        ]
      }
    },
    {
      "name": "device counts -- both wireless metrics in one tick",
      "producer": "telemetry",
      "body": {
        "buildingId": "bldg-3f2b4c5d",
        "readings": [
          {
            "type": "total_device_count",
            "roomId": "ground-floor",
            "timestamp": 1757251200000,
            "value": 47
          },
          {
            "type": "ratio_device_count",
            "roomId": "ground-floor",
            "timestamp": 1757251200000,
            "value": 24
          }
        ]
      }
    },
    {
      "name": "a multi-room tick is still one batch",
      "producer": "sensor-simulator",
      "body": {
        "buildingId": "bldg-3f2b4c5d",
        "readings": [
          {
            "type": "temperature",
            "roomId": "room-lab-2",
            "timestamp": 1757251200000,
            "value": 21.5
          },
          {
            "type": "people_count",
            "roomId": "room-lab-2",
            "timestamp": 1757251200000,
            "value": 14
          },
          {
            "type": "temperature",
            "roomId": "room-aula-magna",
            "timestamp": 1757251200000,
            "value": 19.0
          },
          {
            "type": "people_count",
            "roomId": "room-aula-magna",
            "timestamp": 1757251200000,
            "value": 132
          }
        ]
      }
    }
  ],
  "rejected": [
    {
      "name": "a reading naming another building",
      "reason": "buildingId: must match the batch's building",
      "body": {
        "buildingId": "bldg-3f2b4c5d",
        "readings": [
          {
            "type": "temperature",
            "roomId": "room-lab-2",
            "timestamp": 1757251200000,
            "value": 21.5,
            "buildingId": "bldg-someone-else"
          }
        ]
      }
    },
    {
      "name": "a metric the registry does not know",
      "reason": "type: unknown sensor type: airQuality -- a combined reading no plugin accepts",
      "body": {
        "buildingId": "bldg-3f2b4c5d",
        "readings": [
          {
            "type": "airQuality",
            "roomId": "room-lab-2",
            "timestamp": 1757251200000,
            "value": 41.2
          }
        ]
      }
    },
    {
      "name": "a reading without a value",
      "reason": "value: required",
      "body": {
        "buildingId": "bldg-3f2b4c5d",
        "readings": [
          {
            "type": "temperature",
            "roomId": "room-lab-2",
            "timestamp": 1757251200000
          }
        ]
      }
    },
    {
      "name": "a measure riding along on another metric's reading",
      "reason": "co2: not a field of indoor_aqi -- one reading, one number",
      "body": {
        "buildingId": "bldg-3f2b4c5d",
        "readings": [
          {
            "type": "indoor_aqi",
            "roomId": "room-lab-2",
            "timestamp": 1757251200000,
            "value": 41.2,
            "co2": 612.0
          }
        ]
      }
    },
    {
      "name": "a fractional count",
      "reason": "value: must be a whole number",
      "body": {
        "buildingId": "bldg-3f2b4c5d",
        "readings": [
          {
            "type": "people_count",
            "roomId": "room-lab-2",
            "timestamp": 1757251200000,
            "value": 14.5
          }
        ]
      }
    },
    {
      "name": "an empty batch",
      "reason": "readings: must not be empty",
      "body": {
        "buildingId": "bldg-3f2b4c5d",
        "readings": []
      }
    }
  ]
}
