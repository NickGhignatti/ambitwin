{
  "service": "telemetry",
  "metrics": [
    {
      "kind": "temperature",
      "label": "Temperature",
      "interface": "ITemperature",
      "unit": "C",
      "source": "telemetry",
      "actions": [
        {
          "name": "setTarget",
          "label": "Set target temperature",
          "parameters": [
            {
              "name": "target",
              "type": "Finite",
              "required": true
            }
          ]
        },
        {
          "name": "increase",
          "label": "Increase temperature",
          "parameters": [
            {
              "name": "step",
              "type": "Finite",
              "required": false
            }
          ]
        },
        {
          "name": "decrease",
          "label": "Decrease temperature",
          "parameters": [
            {
              "name": "step",
              "type": "Finite",
              "required": false
            }
          ]
        }
      ],
      "limit": {
        "min": 18.0,
        "max": 27.0
      }
    },
    {
      "kind": "people_count",
      "label": "People Count",
      "interface": "IPeopleCount",
      "unit": "people",
      "source": "telemetry",
      "actions": [],
      "limit": {
        "max": null
      }
    },
    {
      "kind": "co2",
      "label": "CO2",
      "interface": "ICo2",
      "unit": "ppm",
      "source": "telemetry",
      "actions": [],
      "limit": {
        "max": 1000.0
      }
    },
    {
      "kind": "indoor_aqi",
      "label": "Indoor AQI",
      "interface": "IIndoorAqi",
      "unit": null,
      "source": "telemetry",
      "actions": [],
      "limit": {
        "max": 75.0
      }
    },
    {
      "kind": "humidity",
      "label": "Humidity",
      "interface": "IHumidity",
      "unit": "%",
      "source": "telemetry",
      "actions": [],
      "limit": {
        "min": 30.0,
        "max": 60.0
      }
    },
    {
      "kind": "total_device_count",
      "label": "Total Device Count",
      "interface": "ITotalDeviceCount",
      "unit": "devices",
      "source": "telemetry",
      "actions": [],
      "limit": {}
    },
    {
      "kind": "ratio_device_count",
      "label": "Estimated People Count",
      "interface": "IRatioDeviceCount",
      "unit": "people",
      "source": "telemetry",
      "actions": [],
      "limit": {}
    },
    {
      "kind": "estimated_occupancy",
      "label": "Estimated Occupancy",
      "interface": "IEstimatedOccupancy",
      "unit": "devices",
      "source": "telemetry",
      "actions": [],
      "limit": {}
    }
  ]
}
