{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambitwin.kubeet.dev/schemas/ingest-batch.schema.json",
  "title": "IngestBatch",
  "description": "The body POSTed to /telemetry/ingest. Three producers build it by hand in three languages and telemetry walks it as raw JSON, so no compiler sees this shape. A reading is one metric and one number.",
  "type": "object",
  "required": ["buildingId", "readings"],
  "additionalProperties": false,
  "properties": {
    "buildingId": { "type": "string", "minLength": 1 },
    "readings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "description": "One tick, all-or-nothing. The cap is telemetry's MAX_BATCH_READINGS.",
      "items": { "$ref": "#/$defs/reading" }
    }
  },
  "$defs": {
    "reading": {
      "type": "object",
      "required": ["type", "roomId", "timestamp", "value"],
      "additionalProperties": false,
      "$comment": "No other keys: a device measuring several metrics sends one reading for each.",
      "properties": {
        "type": {
          "$comment": "The registry dispatches on this. An unknown value rejects the whole batch.",
          "enum": [
            "temperature",
            "people_count",
            "co2",
            "indoor_aqi",
            "humidity",
            "total_device_count",
            "ratio_device_count",
            "estimated_occupancy"
          ]
        },
        "roomId": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "number", "description": "Epoch milliseconds." },
        "value": { "type": "number" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "people_count",
                  "total_device_count",
                  "ratio_device_count",
                  "estimated_occupancy"
                ]
              }
            }
          },
          "then": { "properties": { "value": { "type": "integer", "minimum": 0 } } }
        }
      ]
    }
  }
}
